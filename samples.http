}

### 2f Adaptive form: after answering SpO2 = 91 -> next question
POST {{base}}/fhir/Questionnaire/$next-question
Content-Type: application/fhir+json

{
  "resourceType": "Parameters",
  "parameter": [
    {
      "name": "in",
      "resource": {
        "resourceType": "QuestionnaireResponse",
        "id": "qr-o2",
        "contained": [
          {
            "resourceType": "Questionnaire",
            "id": "home-o2-adaptive",
            "url": "http://example.org/fhir/Questionnaire/home-o2-adaptive",
            "version": "1.0.0",
            "status": "active",
            "extension": [
              {
                "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-questionnaireAdaptive",
                "valueBoolean": true
              }
            ],
            "item": [
              {
                "linkId": "spo2",
                "text": "Resting oxygen saturation (SpO2 %) on room air",
                "type": "decimal",
                "required": true
              }
            ]
          }
        ],
        "questionnaire": "#home-o2-adaptive",
        "status": "in-progress",
        "subject": {
          "reference": "Patient/pat-1"
        },
        "item": [
          {
            "linkId": "spo2",
            "answer": [
              {
                "valueDecimal": 91,
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/us/davinci-dtr/StructureDefinition/information-origin",
                    "extension": [
                      {
                        "url": "source",
                        "valueCode": "auto"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}


