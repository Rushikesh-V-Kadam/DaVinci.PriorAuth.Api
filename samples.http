### =====================================================================
### HOW TO USE (Visual Studio 2022 or VS Code with the "REST Client" extension)
### 1. Start the API (F5 or: dotnet run --project src/DaVinci.PriorAuth.Api)
### 2. Open this file. Above each request there is a "Send request" link.
### 3. Click it. The response appears on the right side.
### The JSON bodies are included below, so this file works from any folder.
### Run the requests IN ORDER from top to bottom.
### =====================================================================

@base = http://localhost:5080


### ---------------- STEP 0: is the API running? ----------------
GET {{base}}/cds-services


### =====================================================================
### STEP 1: CRD - the EHR asks "does this order need prior auth?"
### Look at the response: systemActions -> extension -> "pa-needed" and "doc-needed"
### =====================================================================

### S1 Office visit -> pa-needed = no-auth (nothing else to do)
POST {{base}}/cds-services/crd-order-sign
Content-Type: application/json

{
  "hook": "order-sign",
  "hookInstance": "00000000-0000-0000-0000-00000000021f",
  "fhirServer": "https://ehr.example.org/fhir",
  "context": {
    "userId": "Practitioner/prac-1",
    "patientId": "pat-1",
    "encounterId": "enc-1",
    "draftOrders": {
      "resourceType": "Bundle",
      "type": "collection",
      "entry": [
        {
          "resource": {
            "resourceType": "ServiceRequest",
            "id": "sr-99213",
            "status": "draft",
            "intent": "order",
            "code": {
              "coding": [
                {
                  "system": "http://www.ama-assn.org/go/cpt",
                  "code": "99213",
                  "display": "Office visit"
                }
              ]
            },
            "subject": {
              "reference": "Patient/pat-1"
            },
            "authoredOn": "2026-09-24",
            "requester": {
              "reference": "Practitioner/prac-1"
            },
            "insurance": [
              {
                "reference": "Coverage/cov-1"
              }
            ]
          }
        }
      ]
    }
  },
  "prefetch": {
    "patient": {
      "resourceType": "Patient",
      "id": "pat-1",
      "identifier": [
        {
          "system": "http://example.org/member-ids",
          "value": "MBR-1001"
        }
      ],
      "name": [
        {
          "family": "Shaw",
          "given": [
            "Amy"
          ]
        }
      ],
      "gender": "female",
      "birthDate": "1970-02-20"
    },
    "coverage": {
      "resourceType": "Bundle",
      "type": "collection",
      "entry": [
        {
          "resource": {
            "resourceType": "Coverage",
            "id": "cov-1",
            "status": "active",
            "subscriberId": "MBR-1001",
            "beneficiary": {
              "reference": "Patient/pat-1"
            },
            "relationship": {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/subscriber-relationship",
                  "code": "self"
                }
              ]
            },
            "period": {
              "start": "2026-01-01",
              "end": "2026-12-31"
            },
            "payor": [
              {
                "identifier": {
                  "system": "http://example.org/payer-ids",
                  "value": "PAYER001"
                },
                "display": "Example Health Plan"
              }
            ],
            "class": [
              {
                "type": {
                  "coding": [
                    {
                      "system": "http://terminology.hl7.org/CodeSystem/coverage-class",
                      "code": "plan"
                    }
                  ]
                },
                "value": "GOLD-PPO",
                "name": "Gold PPO"
              }
            ]
          }
        }
      ]
    },
    "practitioner": {
      "resourceType": "Bundle",
      "type": "collection",
      "entry": [
        {
          "resource": {
            "resourceType": "Practitioner",
            "id": "prac-1",
            "identifier": [
              {
                "system": "http://hl7.org/fhir/sid/us-npi",
                "value": "1111111112"
              }
            ],
            "name": [
              {
                "family": "Jones",
                "given": [
                  "Pat"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "extension": {
    "davinci-crd.configuration": {
      "coverage-info": true,
      "max-cards": 10
    }
  }
}

