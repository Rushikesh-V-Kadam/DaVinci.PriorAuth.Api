### See the Task: COPY identifier[0].value (starts with TRK-)
GET {{base}}/fhir/Task?status=requested

### Provider sends the X-ray report: PASTE the TRK- value in place of PASTE-TRACKING-ID
POST {{base}}/fhir/$submit-attachment
Content-Type: application/fhir+json

{
  "resourceType": "Parameters",
  "parameter": [
    { "name": "TrackingId", "valueIdentifier": { "system": "http://example.org/cdex/tracking-ids", "value": "PASTE-TRACKING-ID" } },
    { "name": "AttachTo", "valueCode": "preauthorization" },
    { "name": "ProviderId", "valueIdentifier": { "system": "http://hl7.org/fhir/sid/us-npi", "value": "1111111112" } },
    { "name": "MemberId", "valueIdentifier": { "system": "http://example.org/member-ids", "value": "MBR-1001" } },
    { "name": "Attachment", "part": [
        { "name": "LineItem", "valueString": "1" },
        { "name": "Code", "valueCodeableConcept": { "coding": [ { "system": "http://loinc.org", "code": "18748-4" } ] } },
        { "name": "Content", "resource": {
            "resourceType": "DocumentReference", "status": "current",
            "type": { "coding": [ { "system": "http://loinc.org", "code": "18748-4" } ] },
            "content": [ { "attachment": { "contentType": "text/plain", "data": "S25lZSBYLXJheTogS0wgZ3JhZGUgNA==" } } ] } }
    ] }
  ]
}

