### P13 Provider subscribes to notifications for pended requests -> 201
POST {{base}}/fhir/Subscription
Content-Type: application/fhir+json

{
  "resourceType": "Subscription",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/profile-subscription"
    ]
  },
  "status": "requested",
  "reason": "Pended prior authorization results for Good Health Clinic",
  "criteria": "http://hl7.org/fhir/us/davinci-pas/SubscriptionTopic/PASSubscriptionTopic",
  "_criteria": {
    "extension": [
      {
        "url": "http://hl7.org/fhir/uv/subscriptions-backport/StructureDefinition/backport-filter-criteria",
        "valueString": "ClaimResponse?orgIdentifier=http://hl7.org/fhir/sid/us-npi|1999999992"
      }
    ]
  },
  "channel": {
    "type": "rest-hook",
    "endpoint": "https://ehr.example.org/pas-notifications",
    "payload": "application/fhir+json",
    "_payload": {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/subscriptions-backport/StructureDefinition/backport-payload-content",
          "valueCode": "id-only"
        }
      ]
    },
    "header": [
      "Authorization: Bearer provider-endpoint-secret"
    ]
  }
}


